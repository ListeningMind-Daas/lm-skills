     "default": "curr",
     "description": "데이터 조회 시점 - `curr`: 현재 - `3m`: 3개월 전 - `6m`: 6개월 전 - `9m`: 9개월 전 - `12m`: 12개월 전"
    },
    "limit": {
     "type": "integer",
     "default": 500,
     "minimum": 1.0,
     "maximum": 10000.0,
     "description": "관계 수 제한"
    },
    "hop": {
     "type": "integer",
     "default": 2,
     "minimum": 1.0,
     "maximum": 3.0,
     "description": "hop 수"
    },
    "orientation": {
     "type": "string",
     "enum": [
      "UNDIRECTED",
      "NATURAL",
      "REVERSE"
     ],
     "default": "UNDIRECTED",
     "description": "관계 방향"
    },
    "data_type": {
     "type": "string",
     "enum": [
      "communities",
      "rels",
      "all"
     ],
     "default": "communities",
